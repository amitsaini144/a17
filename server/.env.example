# Copy to .env and adjust. Never commit .env.
ENVIRONMENT=local
DEBUG=true
DATABASE_URL=postgresql+asyncpg://a17:a17@localhost:5432/a17
CORS_ORIGINS=["http://localhost:3000"]

# Public base URL for catalog images: the CloudFront domain (S3 behind it), locally too, since the
# images are no longer in the repo. Absolute URL, no trailing slash. Same value as ui/.env.local.
ASSETS_BASE_URL=https://dxxxxxxxx.cloudfront.net

# Signs access tokens (JWT). Optional locally (a dev default is used); required in production,
# 32+ random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# JWT_SECRET=
# Session cookies are Secure; browsers accept that on http://localhost, so keep this true.
# COOKIE_SECURE=true
