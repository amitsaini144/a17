# Copy to .env.local and adjust. Never commit .env.local.
# FastAPI backend origin; `/api/*` is proxied there (defaults to http://localhost:8000 in `yarn dev`).
API_URL=http://localhost:8000
# CDN for catalog images; must match the API's ASSETS_BASE_URL (e.g. https://dxxxxxxxx.cloudfront.net).
# Leave unset while the API's ASSETS_BASE_URL is empty and images are served from public/images.
ASSETS_BASE_URL=
