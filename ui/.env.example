# Copy to .env.local and adjust. Never commit .env.local.
# FastAPI backend origin; `/api/*` is proxied there (defaults to http://localhost:8000 in `yarn dev`).
API_URL=http://localhost:8000
# CDN for catalog images; same value as the API's ASSETS_BASE_URL. Next.js only optimizes images
# from this host, so product images fail to load if it is missing or differs.
ASSETS_BASE_URL=https://dxxxxxxxx.cloudfront.net
